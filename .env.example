# Postgres (Neon) — production/dev connection string. Get it from the Neon console
# (Project → Connection Details → Pooled connection). Required from step 1.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/boleteria?sslmode=require

# Local Postgres started by docker-compose.yml, used ONLY by tests. Required from step 1.
TEST_DATABASE_URL=postgresql://boleteria:boleteria_test@localhost:5433/boleteria_test

# Better Auth. Generate with: pnpm exec @better-auth/cli secret
# Required from step 3.
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-change-me
BETTER_AUTH_URL=http://localhost:3000

# HMAC key that signs every QR token. 32+ random bytes, e.g. `openssl rand -hex 32`.
# Required from step 5.
QR_HMAC_SECRET=change-me-64-hex-chars-change-me-change-me-change-me-change-me

# One-time admin account created by the seed script. Required from step 3.
ADMIN_SEED_EMAIL=admin@example.org
ADMIN_SEED_PASSWORD=change-me-admin-password
